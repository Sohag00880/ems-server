{
    "name": "ems-server",
    "private": true,
    "version": "0.2.0",
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "dev": "node --watch src/index.js",
        "start": "node src/index.js",
        "seed": "node src/scripts/seed.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint \"src/**/*.js\" --max-warnings 0",
        "lint:fix": "eslint \"src/**/*.js\" --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "express-rate-limit": "^7.4.0",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.7.0",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "mongodb-memory-server": "^10.0.0",
        "prettier": "^3.3.2",
        "supertest": "^7.0.0",
        "vitest": "^2.1.1"
    }
}